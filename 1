-- we download the files for "minux-main" as described in the manifest
print("manifest retrieved, downloading files")
while file ~= nil do
	file = temp.readLine()
	if file ~= nil then
		fs.delete(file)
		shell.run("wget "..aptsource.."repository/minux-main/"..file.." "..file)
	end
end
temp.close()
			
