local MODEM_SIDE = "top" -- УБЕДИСЬ, ЧТО МОДЕМ НАПРАВДУ СВЕРХУ! Если сзади, поменяй на "back"
rednet.open(MODEM_SIDE)

local DNS_USER = "dns_root_system_v2"
local DNS_PASS = "global_dns_password_123"
local DNS_FILE = "domains.txt"

-- Функция принудительного вывода сетевых ошибок на экран, чтобы мы не гадали
local function showError(msg)
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.red)
    term.clear()
    term.setCursorPos(1, 2)
    print("!! NETWORK ERROR !!")
    term.setTextColor(colors.white)
    print("\n" .. msg)
    print("\nPress any key to continue...")
    os.pullEvent("key")
end

local function findServers()
    local ids = { rednet.lookup("cloud_disk") }
    if #ids == 1 and type(ids[1]) == "number" then return ids end
    if #ids == 0 or ids[1] == nil then return {} end
    return ids
end

local function sendRequest(user, pass, payload)
    payload.username = user
    payload.password = pass
    local serverIDs = findServers()
    if #serverIDs == 0 then 
        showError("No servers found with protocol 'cloud_disk'.\nCheck if your Server is running!")
        return nil 
    end
    for _, sID in ipairs(serverIDs) do
        rednet.send(sID, payload, "cloud_disk")
        local id, response = rednet.receive("cloud_disk", 2.0)
        if response then return response end
    end
    showError("Server did not respond to sendRequest.")
    return nil
end

local function getDNS()
    local serverIDs = findServers()
    if #serverIDs == 0 then 
        showError("DNS Error: Cloud drive server not found.\nMake sure modem is active on Server.")
        return {} 
    end
    
    for _, sID in ipairs(serverIDs) do
        local payload = {username = DNS_USER, password = DNS_PASS, action = "download", filename = DNS_FILE}
        rednet.send(sID, payload, "cloud_disk")
        
        local id, response = rednet.receive("cloud_disk", 3.0) -- Увеличили таймаут до 3 секунд
        if response then
            if response.success then
                local data = textutils.unserialize(response.content)
                return data or {}
            else
                -- Если сервер ответил ошибкой (например, файла еще нет)
                return {}
            end
        end
    end
    
    showError("Server timeout.\nSent request to ID "..(serverIDs[1] or "?")..", but got no response.")
    return {}
end

local function saveDNS(dnsData)
    local content = textutils.serialize(dnsData)
    sendRequest(DNS_USER, DNS_PASS, {action = "upload", filename = DNS_FILE, content = content})
end

local function extractLinks(text)
    local links = {}
    if type(text) ~= "string" then return links end
    for name, domain in text:gmatch("%[([^%-%>]+)%-%>([^%]]+)%]") do
        table.insert(links, { name = name, domain = domain:gsub("%s+", ""):lower() })
    end
    return links
end

local function cleanText(text)
    if type(text) ~= "string" then return "" end
    return text:gsub("%[([^%-%>]+)%-%>[^%]]+%]", "%1")
end

local function createSiteManager()
    term.clear()
    term.setCursorPos(1,1)
    term.setTextColor(colors.yellow)
    print("=== Register a New Website/App ===")
    term.setTextColor(colors.white)
    write("Choose domain (e.g., store): cloud://")
    
    local domain = read():lower()
    if domain == "" or domain:match("%s") then
        print("Error: Domain cannot contain spaces.")
        sleep(2) return
    end
    
    print("Connecting to server to check domain...")
    local dns = getDNS()
    
    if dns[domain] then
        print("Error: This domain is already taken!")
        sleep(2) return
    end
    print("\nHow would you like to provide the content?")
    print("[1] Type text manually inside the editor")
    print("[2] Import an existing local file / app")
    write("Select option (1-2): ")
    local choice = read()
    local rawContent = ""
    local contentType = "text" 
    if choice == "1" then
        print("\nEnter your website content.")
        print("To SAVE & PUBLISH, type :w on a new line.")
        print("----------------------------------------")
        local lines = {}
        while true do
            local line = read()
            if line == ":w" then break end
            table.insert(lines, line)
        end
        rawContent = table.concat(lines, "\n")
    elseif choice == "2" then
        print("\nEnter the absolute local file path.")
        write("Path (e.g., /game.lua): ")
        local path = read()
        if not fs.exists(path) or fs.isDir(path) then
            print("Error: File does not exist.")
            sleep(2) return
        end
        print("\nExecution mode:")
        print("[1] Text Page")
        print("[2] Application (Run as executable)")
        write("Select mode (1-2): ")
        local modeChoice = read()
        if modeChoice == "2" then contentType = "app" end
        local file = fs.open(path, "r")
        rawContent = file.readAll()
        file.close()
    else
        print("Invalid option.")
        sleep(2) return
    end
    
    dns[domain] = { type = contentType, content = rawContent }
    print("Uploading to cloud database...")
    saveDNS(dns)
    print("\nSuccessfully published!")
    sleep(2)
end

local function searchEngine(query)
    local dns = getDNS()
    local results = {}
    query = query:lower()
    for domain, data in pairs(dns) do
        local content = type(data) == "table" and data.content or tostring(data)
        local dType = type(data) == "table" and data.type or "text"
        if domain:find(query) or content:lower():find(query) then
            table.insert(results, { domain = domain, preview = "[" .. dType:upper() .. "] " .. cleanText(content):sub(1, 15) .. "..." })
        end
    end
    return results
end

local function runAsApplication(domain, code)
    term.clear()
    term.setCursorPos(1, 1)
    local tempPath = ".browser_cache_" .. domain .. ".lua"
    local file = fs.open(tempPath, "w")
    file.write(code)
    file.close()
    print("Launching cloud://" .. domain .. "...")
    sleep(0.5)
    local success, err = pcall(shell.run, tempPath)
    if fs.exists(tempPath) then fs.delete(tempPath) end
    if not success then
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.red)
        print("\n[Application Crashed]\nError: " .. tostring(err))
        print("\nPress any key to return...")
        os.pullEvent("key")
    end
end

local navButtons = {}
local clickableContent = {}

local function drawBrowser(mode, target, data, activeLinks)
    term.clear()
    local w, h = term.getSize()
    clickableContent = {}
    
    term.setBackgroundColor(colors.blue)
    term.setTextColor(colors.white)
    term.setCursorPos(1, 1)
    term.clearLine()
    if mode == "page" then write(" URL: cloud://" .. target)
    elseif mode == "search" then write(" Search Results: " .. target)
    else write(" CloudNet Home Page") end
    
    term.setBackgroundColor(colors.black)
    
    if mode == "main" then
        term.setCursorPos(1, 3)
        term.setTextColor(colors.lime)
        print(" Welcome to CloudNet Browser!")
        term.setTextColor(colors.white)
        print("\n Search the cloud network using keywords or\n instantly create your own personal domain.")
        print("\n Use the touch buttons below to navigate.")
        
    elseif mode == "page" then
        term.setTextColor(colors.white)
        term.setCursorPos(1, 3)
        if data then
            print(cleanText(data))
            if #activeLinks > 0 then
                term.setCursorPos(1, h - 3)
                print(string.rep("-", w))
                write(" Links: ")
                
                local currentX = 9
                for i, link in ipairs(activeLinks) do
                    if i > 4 then break end 
                    local btnText = " " .. link.name .. " "
                    local len = #btnText
                    
                    term.setCursorPos(currentX, h - 2)
                    term.setBackgroundColor(colors.cyan)
                    term.setTextColor(colors.black)
                    write(btnText)
                    
                    table.insert(clickableContent, {
                        x1 = currentX,
                        x2 = currentX + len - 1,
                        y = h - 2,
                        domain = link.domain
                    })
                    currentX = currentX + len + 2
                end
            end
        else
            term.setTextColor(colors.red)
            print(" Error 404: Website Not Found.")
            term.setTextColor(colors.gray)
            print(" The domain does not exist in the DNS registry.")
        end
        
    elseif mode == "search" then
        term.setCursorPos(1, 3)
        term.setTextColor(colors.yellow)
        print(" Search results for '" .. target .. "':")
        print(string.rep("-", w))
        term.setTextColor(colors.white)
        if not data or #data == 0 then
            print(" No results found. Try using different keywords.")
        else
            local startY = 5
            for i, res in ipairs(data) do
                if i > h - 3 then break end
                local currentY = startY + (i - 1)
                term.setCursorPos(1, currentY)
                
                term.setBackgroundColor(colors.gray)
                term.setTextColor(colors.yellow)
                write(" GO ")
                term.setBackgroundColor(colors.black)
                term.setTextColor(colors.lime)
                write(" cloud://" .. res.domain)
                term.setTextColor(colors.white)
                print(" " .. res.preview)
                
                table.insert(clickableContent, {
                    x1 = 1,
                    x2 = w,
                    y = currentY,
                    domain = res.domain
                })
            end
        end
    end
    
    -- Нижняя панель навигации
    term.setBackgroundColor(colors.gray)
    term.setCursorPos(1, h)
    term.clearLine()
    
    navButtons = {
        { text = " Search ",    x1 = 2,  x2 = 11, action = "search" },
        { text = " Go to URL ", x1 = 13, x2 = 25, action = "goto" },
        { text = " Create Site ", x1 = 27, x2 = 41, action = "create" },
        { text = " Home ",      x1 = 43, x2 = 50, action = "home" }
    }
    
    for _, btn in ipairs(navButtons) do
        term.setCursorPos(btn.x1, h)
        term.setBackgroundColor(colors.lightGray)
        term.setTextColor(colors.black)
        write(btn.text)
    end
    term.setBackgroundColor(colors.black)
end

local viewMode = "main" 
local viewTarget = ""
local viewData = nil
local activeLinks = {}

local function loadPage(domain)
    local dns = getDNS() 
    local record = dns[domain]
    
    activeLinks = {} 
    if record then
        if type(record) == "table" and record.type == "app" then
            runAsApplication(domain, record.content)
            viewMode = "main"
        else
            viewMode = "page"
            viewTarget = domain
            viewData = type(record) == "table" and record.content or record
            activeLinks = extractLinks(viewData)
        end
    else
        viewMode = "page"
        viewTarget = domain
        viewData = nil 
    end
end

local function handleAction(action)
    sleep(0.1) -- Защита от перехвата клика функцией read()
    
    if action == "home" then
        viewMode = "main"
        activeLinks = {}
    elseif action == "create" then
        createSiteManager()
        viewMode = "main"
        activeLinks = {}
    elseif action == "goto" then
        local w, h = term.getSize()
        term.setCursorPos(1, h)
        term.setBackgroundColor(colors.lime)
        term.setTextColor(colors.black)
        term.clearLine()
        write("Enter domain: ")
        local domain = read():lower()
        if domain ~= "" then loadPage(domain) end
    elseif action == "search" then
        local w, h = term.getSize()
        term.setCursorPos(1, h)
        term.setBackgroundColor(colors.yellow)
        term.setTextColor(colors.black)
        term.clearLine()
        write("Search Query: ")
        local query = read()
        if query ~= "" then
            viewMode = "search"
            viewTarget = query
            viewData = searchEngine(query)
            activeLinks = {}
        end
    end
end

-- Главный цикл обработки событий
while true do
    drawBrowser(viewMode, viewTarget, viewData, activeLinks)
    local event, p1, p2, p3 = os.pullEvent()
    local w, h = term.getSize()
    
    if event == "mouse_click" or event == "monitor_touch" then
        local clickX, clickY = p2, p3
        
        if clickY == h then
            for _, btn in ipairs(navButtons) do
                if clickX >= btn.x1 and clickX <= btn.x2 then
                    handleAction(btn.action)
                    break
                end
            end
        else
            for _, item in ipairs(clickableContent) do
                if clickY == item.y and clickX >= item.x1 and clickX <= item.x2 then
                    loadPage(item.domain)
                    break
                end
            end
        end
    end
end
