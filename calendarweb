-- Проверка наличия терминала
local terminal = term
if not terminal then
    print("Terminal not found!")
    return
end

-- Настройка терминала
terminal.setTextScale(1)
terminal.clear()

-- Определяем дни недели
local daysOfWeek = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}

-- Функция для определения текущего дня недели
local function getDayOfWeek(day)
    return daysOfWeek[(day - 1) % 7 + 1]
end

-- Основной цикл для отображения дней недели
while true do
    -- Получаем текущий день игры
    local day = os.day() -- Возвращает текущий игровой день
    local currentDayOfWeek = getDayOfWeek(day)

    -- Очищаем терминал перед выводом
    terminal.clear()
    terminal.setCursorPos(1, 1)
    terminal.write("Days of the Week:")

    -- Выводим список дней недели, выделяя текущий день
    for i = 1, #daysOfWeek do
        local dayName = daysOfWeek[i]
        terminal.setCursorPos(1, i + 1)
        if dayName == currentDayOfWeek then
            terminal.write("> " .. dayName) -- Выделяем текущий день
        else
            terminal.write("  " .. dayName)
        end
    end

    -- Ждем 5 секунд перед обновлением
    sleep(5)
end
