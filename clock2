-- Находим подключенный монитор
local monitor = peripheral.find("monitor")
if not monitor then
    print("Monitor not found! Make sure a monitor is connected.")
    return
end

-- Настройка монитора
monitor.setTextScale(1)
monitor.clear()

-- Функция для отображения времени на экране с механической стрелкой
local function drawClock(hour, minute)
    -- Очистить экран
    monitor.clear()

    -- Выводим циферблат (в нашем случае это будет ограниченный 4x4)
    local dial = {
        "1", "2", "3", "4"
    }

    -- Позиции для часовой и минутной стрелки
    local hourArrowPos = {x = 2, y = 2}  -- Позиция часовой стрелки
    local minuteArrowPos = {x = 3, y = 2} -- Позиция минутной стрелки

    -- Часовая стрелка (рассчитываем в зависимости от времени)
    local hourArrow = "H"
    local minuteArrow = "M"

    -- Размещение стрелок
    monitor.setCursorPos(hourArrowPos.x, hourArrowPos.y)
    monitor.write(hourArrow)

    monitor.setCursorPos(minuteArrowPos.x, minuteArrowPos.y)
    monitor.write(minuteArrow)
end

-- Основной цикл
while true do
    -- Получаем текущее время
    local hour = tonumber(os.date("%I")) -- Часы в 12-часовом формате
    local minute = tonumber(os.date("%M")) -- Минуты

    -- Отображаем время на экране
    drawClock(hour, minute)

    -- Ждем 60 секунд перед обновлением
    sleep(60)
end
