-- Находим подключенный монитор
local monitor = peripheral.find("monitor")
if not monitor then
    print("Monitor not found! Make sure a monitor is connected.")
    return
end

-- Настройка монитора
monitor.setTextScale(1)
monitor.clear()

-- Функция для отображения времени с часовой стрелкой на экране 4x4
local function drawClock(hour, minute)
    -- Очистить экран
    monitor.clear()

    -- Рассчитываем позиции стрелок для простого отображения
    local hourPos = {x = 2, y = 2} -- Часовая стрелка
    local minutePos = {x = 3, y = 2} -- Минутная стрелка

    -- Используем символы для стрелок, имитируя часы
    local hourArrow = "H"
    local minuteArrow = "M"

    -- Выводим стрелки на экран
    monitor.setCursorPos(hourPos.x, hourPos.y)
    monitor.write(hourArrow)

    monitor.setCursorPos(minutePos.x, minutePos.y)
    monitor.write(minuteArrow)
end

-- Основной цикл
while true do
    -- Получаем текущее время
    local hour = tonumber(os.date("%I")) -- Часы в 12-часовом формате
    local minute = tonumber(os.date("%M")) -- Минуты

    -- Отображаем время на экране
    drawClock(hour, minute)

    -- Ждем 60 секунд перед обновлением
    sleep(60)
end
