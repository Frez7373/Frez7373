-- Configuration
local TANK_NAME = "create:fluid_tank_0"
local REFRESH_RATE = 2.0 -- How often to check the tank (in seconds)
local ANIMATION_SPEED = 0.05 -- Delay between flip frames

-- Find and wrap the tank and monitor
local tank = peripheral.wrap(TANK_NAME)
local monitor = peripheral.find("monitor")

if not tank then
    error("Could not find the fluid tank! Check the name: " .. TANK_NAME)
end

if not monitor then
    error("Could not find any attached monitor!")
end

-- Set up monitor size and scale
monitor.setTextScale(1)
local width, height = monitor.getSize()

-- Variables to store the current displayed text
local currentLines = {}
for i = 1, height do
    currentLines[i] = string.rep(" ", width)
end

-- Helper function to center text
local function centerText(text, maxWidth)
    if #text >= maxWidth then return string.sub(text, 1, maxWidth) end
    local padLeft = math.floor((maxWidth - #text) / 2)
    local padRight = maxWidth - #text - padLeft
    return string.rep(" ", padLeft) .. text .. string.rep(" ", padRight)
end

-- Simulates the mechanical flipping animation of the Create mod
local function flipToLines(targetLines)
    for step = 1, 3 do
        monitor.clear()
        for y = 1, height do
            local current = currentLines[y] or string.rep(" ", width)
            local target = targetLines[y] or string.rep(" ", width)
            local displayStr = ""
            
            for x = 1, width do
                local cChar = string.sub(current, x, x)
                local tChar = string.sub(target, x, x)
                
                if cChar == tChar then
                    displayStr = displayStr .. tChar
                else
                    if step == 1 then displayStr = displayStr .. "-"
                    elseif step == 2 then displayStr = displayStr .. "_"
                    else displayStr = displayStr .. tChar end
                end
            end
            
            monitor.setCursorPos(1, y)
            monitor.write(displayStr)
        end
        sleep(ANIMATION_SPEED)
    end
    currentLines = targetLines
end

-- Deep analysis of the tank structure to find any liquid data
local function fetchFluidData()
    local rawData = nil
    
    -- Try all known methods to get the raw data table
    if type(tank.getFluidDetail) == "function" then
        rawData = tank.getFluidDetail()
    elseif type(tank.getFluidDetails) == "function" then
        local details = tank.getFluidDetails()
        rawData = details and details[1] or details
    elseif type(tank.tanks) == "function" then
        local t = tank.tanks()
        rawData = t and t[1] or t
    elseif type(tank.getFluids) == "function" then
        local f = tank.getFluids()
        rawData = f and f[1] or f
    end

    -- If the returned data is a list of tanks, unpack the first one
    if rawData and rawData[1] and type(rawData[1]) == "table" then
        rawData = rawData[1]
    end

    -- Debug print to computer console so you can see what the tank actually sends
    if rawData then
        print("--- Debug Tank Data ---")
        for k, v in pairs(rawData) do
            print(tostring(k) .. ": " .. tostring(v))
        end
    else
        print("Warning: Tank returned no data table.")
    end

    return rawData
end

-- Formats the tank data into readable layout lines
local function getTankDisplayLines()
    local info = fetchFluidData()
    local lines = {}
    
    for i = 1, height do lines[i] = string.rep(" ", width) end
    
    lines[1] = centerText("== BOILER STATUS ==", width)
    
    -- Universal extraction strategy
    local amount = nil
    local name = nil
    local capacity = 16000
    
    if info and type(info) == "table" then
        -- Search for any amount/count/contents key
        amount = info.amount or info.count or info.amountInLevel or info.fluidAmount
        name = info.name or info.displayName or info.id or info.fluid
        capacity = info.capacity or info.maxAmount or 16000
        
        -- If amount is still nil, check if the table itself has a nested 'contents' table
        if not amount and info.contents and type(info.contents) == "table" then
            amount = info.contents.amount or info.contents.count
            name = info.contents.name or info.contents.id
        end
    end
    
    -- If we found valid amount data (even if it's 0, but we have a name)
    if amount and amount > 0 and name then
        local fluidName = tostring(name):match("([^:]+)$") or tostring(name)
        fluidName = fluidName:upper()
        
        lines[3] = centerText("LIQUID: " .. fluidName, width)
        
        local amountStr = string.format("%d mB", amount)
        lines[4] = centerText(amountStr, width)
        
        local barWidth = width - 4
        if barWidth > 5 then
            if type(tank.getFluidCapacity) == "function" then
                capacity = tank.getFluidCapacity()
            end
            
            local fillRatio = math.min(1, amount / capacity)
            local filledChars = math.floor(fillRatio * barWidth)
            local emptyChars = barWidth - filledChars
            
            local bar = "[" .. string.rep("#", filledChars) .. string.rep(".", emptyChars) .. "]"
            lines[5] = centerText(bar, width)
        end
    else
        -- If no active fluid amount was parsed
        lines[3] = centerText("TANK EMPTY / IDLE", width)
        lines[4] = centerText("0 mB", width)
    end
    
    return lines
end

-- Main Loop
print("Display board is running... Press Ctrl+T to stop.")
monitor.setBackgroundColor(colors.black)
monitor.setTextColor(colors.white)
monitor.clear()

while true do
    local newLines = getTankDisplayLines()
    
    local changed = false
    for i = 1, height do
        if newLines[i] ~= currentLines[i] then
            changed = true
            break
        end
    end
    
    if changed then
        flipToLines(newLines)
    end
    
    sleep(REFRESH_RATE)
end
