-- Settings
local side = "back"          -- Side where the redstone signal is sent (e.g., left, right, top, etc.)
local password = "1234"      -- Your password
local openTime = 3           -- How long to keep the door open (in seconds)

-- Main loop
while true do
  term.clear()
  term.setCursorPos(1, 1)
  write("Enter password: ")
  local input = read("*")    -- Hidden input
  if input == password then
    term.clear()
    term.setCursorPos(1, 1)
    print("Correct password! Opening...")
    redstone.setOutput(side, true)
    sleep(openTime)
    redstone.setOutput(side, false)
  else
    print("Incorrect password.")
    sleep(1)
  end
end
