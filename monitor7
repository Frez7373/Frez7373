-- Ищем подключенный внешний монитор
local monitor = peripheral.find("monitor")

if not monitor then
    error("External monitor not found! Connect a Monitor block.")
end

-- Перенаправляем весь вывод term на внешний монитор
local oldTerm = term.redirect(monitor)

-- Настройки цветов
local termColor = term.isColor()
local COLOR_BG = colors.black
local COLOR_TEXT = termColor and colors.lightGray or colors.white
local COLOR_FRAME = termColor and colors.green or colors.white
local COLOR_ALERT = termColor and colors.red or colors.white

term.setBackgroundColor(COLOR_BG)
term.setTextColor(COLOR_TEXT)
term.clear()

-- Получаем размер внешнего монитора
local w, h = term.getSize()

local function drawFrame()
    term.setTextColor(COLOR_FRAME)
    
    term.setCursorPos(1, 1)
    write(string.rep("=", w))
    term.setCursorPos(1, h)
    write(string.rep("=", w))
    
    for i = 2, h - 1 do
        term.setCursorPos(1, i)
        write("|")
        term.setCursorPos(w, i)
        write("|")
    end
    
    local title = " [ BUNKER MANAGEMENT SYSTEM v2.6 ] "
    local startX = math.max(2, math.floor((w - #title) / 2))
    term.setCursorPos(startX, 1)
    write(title)
end

local function getMinecraftTime()
    local hour = math.floor(os.time())
    local minute = math.floor((os.time() - hour) * 60)
    local day = os.day()
    
    return string.format("Day: %d | Time: %02d:%02d", day, hour, minute)
end

-- Инициализация базовых значений для плавной симуляции
local baseEnergy = 98.4
local baseRad = 12.4

-- Отрисовка статической рамки
drawFrame()

