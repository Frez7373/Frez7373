-- URL для получения данных о курсе валют
local url = "https://api.exchangerate-api.com/v4/latest/USD"

-- Функция для получения данных с API
local function fetchExchangeRate()
    local response = http.get(url)
    if response then
        local data = response.readAll()
        response.close()
        return textutils.unserializeJSON(data)
    else
        return nil
    end
end

-- Основной цикл программы
local function main()
    print("Получаем курс доллара к рублю...")
    while true do
        local rateData = fetchExchangeRate()
        if rateData and rateData.rates and rateData.rates.RUB then
            local rate = rateData.rates.RUB
            term.clear()
            term.setCursorPos(1, 1)
            print("Курс доллара к рублю:")
            print("1 USD = " .. string.format("%.2f", rate) .. " RUB")
        else
            term.clear()
            term.setCursorPos(1, 1)
            print("Ошибка: Не удалось получить курс валют.")
        end
        sleep(60) -- Обновляем данные каждые 60 секунд
    end
end

main()
